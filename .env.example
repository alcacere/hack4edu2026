# Copia este fichero a .env (cp .env.example .env). .env está en .gitignore.

# Ollama local (API compatible OpenAI). En el navegador se usa vía el proxy /llm de Vite.
LLM_BASE_URL=http://localhost:11434/v1
# Modelo por defecto. Tags verificados con `ollama list` (Ollama 0.40.14) el 2026-11-04:
#   gemma4:e2b (4,6 GB)  qwen3.5:4b (3,3 GB)  — probados de verdad en un portátil de 7 GB de RAM sin GPU.
#   gemma4:e4b (~6,6 GB) — tag de ollama.com/library, NO probado (no cabe bien en 7 GB de RAM).
# Por defecto gemma4:e4b (decisión vigente). En un equipo de 7–8 GB de RAM usa en su lugar:
#   LLM_MODEL=gemma4:e2b
#   LLM_MODELS=gemma4:e2b,qwen3.5:4b
LLM_MODEL=gemma4:e4b
# Modelos del selector (separados por comas). Pon solo los que salgan en `ollama list`:
# un modelo no descargado da «El modelo respondió con un error (404)».
LLM_MODELS=gemma4:e4b,gemma4:e2b,qwen3.5:4b
# Tiempo máximo por respuesta en milisegundos. En CPU, la PRIMERA respuesta tras cambiar de modelo
# incluye cargarlo en memoria (medido: 166–444 s con 7 GB de RAM). Precalienta antes de la demo
# (ver «Cómo arrancar la demo» en docs/STATE.md) o sube este valor.
LLM_TIMEOUT_MS=60000
# reasoning_effort que se envía al modelo. «none» desactiva el razonamiento de Gemma 4 / Qwen 3.5
# (medido con gemma4:e2b: 46 tokens en 4 s sin razonamiento frente a 433 tokens con él).
# Déjalo vacío para no enviarlo.
LLM_REASONING_EFFORT=none
# 1 = respuestas grabadas en fixtures/, sin modelo ni red. También: añade ?demo=1 a la URL.
DEMO_MODE=0
