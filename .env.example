# Ollama local (API compatible OpenAI)
LLM_BASE_URL=http://localhost:11434/v1
# Verifica el tag exacto con: ollama search gemma4  /  ollama list
LLM_MODEL=gemma4:e4b
# Modelos disponibles en el selector (separados por comas)
LLM_MODELS=gemma4:e4b,gemma4:e2b,qwen3.5:4b
# 1 = respuestas grabadas en fixtures/, sin modelo ni red
DEMO_MODE=0
