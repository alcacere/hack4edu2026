# Copia este fichero a .env (cp .env.example .env). .env está en .gitignore.

# Ollama local (API compatible OpenAI). En el navegador se usa vía el proxy /llm de Vite.
LLM_BASE_URL=http://localhost:11434/v1
# Modelo por defecto. Tags verificados en ollama.com/library el 2026-11-04:
#   gemma4:e4b (~6,6 GB)  gemma4:e2b (~4,6 GB)  qwen3.5:4b (~3,4 GB)
# Comprueba los que tienes con: ollama list
LLM_MODEL=gemma4:e4b
# Modelos del selector (separados por comas)
LLM_MODELS=gemma4:e4b,gemma4:e2b,qwen3.5:4b
# Tiempo máximo por respuesta en milisegundos (CPU sin GPU puede ser lenta)
LLM_TIMEOUT_MS=60000
# 1 = respuestas grabadas en fixtures/, sin modelo ni red. También: añade ?demo=1 a la URL.
DEMO_MODE=0
