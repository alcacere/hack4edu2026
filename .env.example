# Copia este fichero a .env (cp .env.example .env). .env está en .gitignore.

# Ollama local (API compatible OpenAI). En el navegador se usa vía el proxy /llm de Vite.
# 11435 = contenedor Docker del README (no choca con un Ollama nativo antiguo en 11434).
LLM_BASE_URL=http://localhost:11435/v1
# Modelo único: Gemma 4 (Apache-2.0), decisión humana del 2026-11-04 (issue #1).
# gemma4:e2b (4,6 GB) es el defecto: medido 3,1 s en caliente y 14,6 tokens/s en CPU sin GPU.
# gemma4:e4b (~6,6 GB) solo si un humano lo decide tras medirlo. Comprueba el tag con
# `docker exec ollama ollama list`: un modelo no descargado da «El modelo respondió con un error (404)».
LLM_MODEL=gemma4:e2b
# Lista de modelos (separados por comas). Con uno solo, la interfaz muestra su nombre sin selector.
LLM_MODELS=gemma4:e2b
# Tiempo máximo por respuesta en milisegundos. En CPU, la PRIMERA respuesta tras cambiar de modelo
# incluye cargarlo en memoria (medido: 166–444 s con 7 GB de RAM). Precalienta antes de la demo
# (ver «Cómo arrancar la demo» en docs/STATE.md) o sube este valor.
LLM_TIMEOUT_MS=60000
# Tiempo máximo del plan de estudio (medido en un portátil de 7,5 GB sin GPU: 22–49 s por plan).
LLM_PLAN_TIMEOUT_MS=180000
# reasoning_effort que se envía al modelo. «none» desactiva el razonamiento de Gemma 4
# (medido con gemma4:e2b: 46 tokens en 4 s sin razonamiento frente a 433 tokens con él).
# Déjalo vacío para no enviarlo.
LLM_REASONING_EFFORT=none
# 1 = respuestas grabadas en fixtures/, sin modelo ni red. También: añade ?demo=1 a la URL.
DEMO_MODE=0
