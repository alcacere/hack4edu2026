{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@ai/*": ["ai/*"], "@fixtures/*": ["fixtures/*"] }
  },
  "include": ["app/src", "ai", "fixtures", "scripts/*.ts", "vite.config.ts"]
}
