+name: Tarea
+description: Unidad de trabajo para un agente o humano
+title: "[Bn] "
+labels: ["status:todo"]
+body:
+  - type: textarea
+    id: objetivo
+    attributes:
+      label: Objetivo
+      description: Qué hay que conseguir, en 1–3 frases.
+    validations:
+      required: true
+  - type: textarea
+    id: criterios
+    attributes:
+      label: Criterios de aceptación
+      description: Lista verificable. El reviewer aprueba contra esto.
+      value: |
+        - [ ]
+        - [ ]
+    validations:
+      required: true
+  - type: textarea
+    id: contexto
+    attributes:
+      label: Contexto y enlaces
+      description: Issues relacionados, ficheros, decisiones previas.
+  - type: dropdown
+    id: agente
+    attributes:
+      label: Responsable
+      options: [coordinator, builder, researcher, writer, reviewer, humano]
+    validations:
+      required: true
